# LocalDevin 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# =============================================================================
# LLM 設定
# =============================================================================
# Ollama の base URL（デフォルト: http://localhost:11434）
LD_OLLAMA_BASE_URL=http://localhost:11434

# メインモデル（Qwen3.6 35B MoE, 3B active）
LD_MAIN_MODEL=qwen3.6:35b-a3b-q4_K_M

# 高速モデル（軽量タスク用）
LD_FAST_MODEL=qwen3.5:9b

# ビジョンモデル（スクリーンショット解析等）
LD_VISION_MODEL=gemma4:26b

# コンテキスト長（トークン数）
LD_CONTEXT_LENGTH=32768

# LLM の temperature（0.0-1.0）
LD_TEMPERATURE=0.1

# =============================================================================
# 安全設定
# =============================================================================
# サーキットブレーカー閾値（連続エラー回数）
LD_MAX_CONSECUTIVE_ERRORS=3

# セッションあたりの最大トークン数
LD_MAX_SESSION_TOKENS=500000

# サンドボックスのメモリ制限
LD_SANDBOX_MEMORY_LIMIT=4g

# サンドボックスの CPU 制限
LD_SANDBOX_CPU_LIMIT=2.0

# =============================================================================
# GitHub 設定
# =============================================================================
# GitHub Personal Access Token（repo スコープが必要）
LD_GITHUB_TOKEN=

# デフォルトブランチ名
LD_GITHUB_DEFAULT_BRANCH=main

# LocalDevin が作成するブランチのプレフィックス
LD_PR_BRANCH_PREFIX=localdevin/

# =============================================================================
# パス設定
# =============================================================================
# Knowledge Base のディレクトリ
LD_KNOWLEDGE_DIR=./knowledge

# Playbook のディレクトリ
LD_PLAYBOOKS_DIR=./playbooks

# SQLite データベースのパス
LD_DB_PATH=./data/sessions.db

# ChromaDB のパス
LD_CHROMA_PATH=./data/chroma

# =============================================================================
# Slack 設定（オプション）
# =============================================================================
# Slack Bot Token（xoxb-...）
LD_SLACK_BOT_TOKEN=

# Slack Signing Secret
LD_SLACK_SIGNING_SECRET=

# 通知先チャンネル（例: #localdevin）
LD_SLACK_CHANNEL=
